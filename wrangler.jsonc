{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aetherengineapi-site",
  "main": "./worker/index.js",
  "compatibility_date": "2026-11-08",
  "workers_dev": true,
  "assets": {
    "directory": "./website",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "aetherengineapi.com.co",
      "custom_domain": true
    },
    {
      "pattern": "www.aetherengineapi.com.co",
      "custom_domain": true
    },
    {
      "pattern": "calc.aetherengineapi.com.co",
      "custom_domain": true
    }
  ]
}
